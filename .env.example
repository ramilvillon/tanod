PORT=3000
LOG_LEVEL=debug
# Host port Docker binds MySQL to (docker-compose). Override if 3306 is taken;
# keep it in sync with DB_PORT below.
MYSQL_PORT=3306
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASS=app
DB_NAME=app
# TLS to MySQL: unset = off for localhost, required (and verified) for any
# other host. DB_SSL=required|off overrides; DB_SSL_CA = PEM of a private CA.
DB_SSL=
DB_SSL_CA=
# RSA keypair (PEM). Generate with: deno task keys:gen
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=http://localhost:3000
# Retired signing public keys still honored during rotation (JSON array of PEM strings)
JWT_PREVIOUS_PUBLIC_KEYS=[]
# Optional bootstrap admin seeded by `deno task db:seed`
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Seconds a just-rotated refresh token can be replayed (refused, family kept);
# 0 = every replay revokes the family
REFRESH_TOKEN_REUSE_GRACE=30
# SSO session lifetime (seconds); auth-code lifetime (seconds)
SSO_SESSION_TTL=2592000
AUTH_CODE_TTL=60
# Email verification link lifetime (seconds)
EMAIL_VERIFICATION_TTL=86400
# Real delivery over SMTP. Setting SMTP_HOST is the switch: leave it empty and
# the log sender is used. The defaults point at the local Mailpit catcher that
# `make up` starts (inbox at http://localhost:8025). For a real relay use its
# host, port 587 (or 465 with SMTP_SECURE=true), and credentials.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Read back by the e2e SMTP test; without it that test is skipped and the
# local e2e count is one short of CI's.
MAILPIT_API=http://127.0.0.1:8025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="tanod <no-reply@tanod.local>"

# Set true ONLY for local development (logs the verification link, which carries
# a live token, and the recipient address in plaintext)
EMAIL_LOG_LINKS=false

# Refuse tokens and sessions to accounts whose email is not yet verified. Needs
# a way to deliver the link (SMTP_HOST, or EMAIL_LOG_LINKS locally) -- the server
# warns at startup if there is none, since every new account would be locked out.
REQUIRE_EMAIL_VERIFICATION=false

# How long expired rows are kept before `deno task db:prune` removes them.
# This is the window in which a replayed refresh token or authorization code is
# still recognised as a replay, so shortening it weakens theft detection.
PRUNE_RETENTION=2592000

# How long a deleted account stays recoverable before db:prune erases it.
ACCOUNT_PURGE_GRACE=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google
# redirect_uri for the SERVER AUTH CODE exchange at POST /users/me/social-links
# -- unrelated to GOOGLE_REDIRECT_URI above, which belongs to the browser leg.
# Leave empty to send no redirect_uri at all: that is the Android/iOS SDK case
# and what this endpoint was built for. Set to `postmessage` for a web/JS popup
# client, or to the exact redirect URI a client authorized against.
GOOGLE_BIND_REDIRECT_URI=
# grant_type=password. Off when unset: RFC 9700 says MUST NOT be used. On here
# for local development only (the README quickstart and guest accounts use it);
# production should leave it unset and use the authorization code flow.
ALLOW_PASSWORD_GRANT=true
# Seals TOTP secrets at rest (AES-256-GCM). Empty = new two-factor setups are
# not offered, but users who already enrolled are still asked for a code
# (recovery codes work; an operator can reset them with DELETE /users/:id/totp,
# which needs no key). Generate with: openssl rand -base64 32
# Losing this key makes every enrolled authenticator app useless (recovery
# codes still work); keep it with the JWT keys.
TOTP_ENCRYPTION_KEY=
# Per-account login throttling: consecutive failures, then a cooling period.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MS=900000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Per-IP budget on POST /users/guest, in the same window as above.
GUEST_RATE_LIMIT=10
# Number of reverse proxies in front of this service; 0 ignores X-Forwarded-For.
# Must be the EXACT hop count (e.g. 2 behind Cloudflare -> nginx): the client IP
# is read that many entries from the right of X-Forwarded-For. Legacy true/false
# still parse as 1/0, but `true` warns at startup.
TRUST_PROXY=0
